---
import '../styles/tokens.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Singing on Grandfather',
  description = 'A century of gospel music on Grandfather Mountain. Halfway to Heaven. MacRae Meadows, Linville, NC — Sunday, June 28, 2026.',
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title === 'Singing on Grandfather' ? title : `${title} — Singing on Grandfather`}</title>
    <link rel="icon" type="image/png" href="/assets/brand/logo-fullcolor.png" />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
      }
    </style>
  </head>
  <body>
    <nav class="nav" id="main-nav">
      <a class="nav__brand" href="/" aria-label="Singing on Grandfather home">
        <img src="/assets/brand/logo-fullcolor.png" alt="Singing on Grandfather" />
      </a>
      <div class="nav__links">
        {[
          ['/', 'Home'],
          ['/lineup', 'Line Up'],
          ['/about', 'About'],
          ['/supporters', 'Supporters'],
        ].map(([href, label]) => (
          <a
            class={`nav__link${pathname === href ? ' is-active' : ''}`}
            href={href}
          >{label}</a>
        ))}
      </div>
      <div class="nav__social">
        <a href="https://www.facebook.com/SingingOnGrandfather" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7h2.3l.45-2.75H13.5V9.4c0-.8.27-1.35 1.43-1.35h1.42V5.6a19 19 0 0 0-2.05-.1c-2.05 0-3.46 1.25-3.46 3.55v1.95H8.5V14h2.34v7z"/></svg>
        </a>
        <a href="https://www.instagram.com/singingongrandfather" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3.6" y="3.6" width="16.8" height="16.8" rx="4.6"/><circle cx="12" cy="12" r="3.8"/><circle cx="17.1" cy="6.9" r="1.1" fill="currentColor" stroke="none"/></svg>
        </a>
      </div>
      <button class="nav__hamburger" id="nav-toggle" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </nav>
    <div class="nav__mobile" id="nav-mobile" aria-hidden="true">
      {[
        ['/', 'Home'],
        ['/lineup', 'Line Up'],
        ['/about', 'About'],
        ['/supporters', 'Supporters'],
        ['/camping', 'Camping'],
        ['/participants', 'History'],
      ].map(([href, label]) => (
        <a class={`nav__mobile-link${pathname === href ? ' is-active' : ''}`} href={href}>{label}</a>
      ))}
      <div class="nav__mobile-social">
        <a href="https://www.facebook.com/SingingOnGrandfather" target="_blank" rel="noopener noreferrer">Facebook</a>
        <a href="https://www.instagram.com/singingongrandfather" target="_blank" rel="noopener noreferrer">Instagram</a>
      </div>
      <a class="btn btn--accent" href="https://www.eventbrite.com/e/singing-on-grandfather-2026-tickets-1983169223533" target="_blank" rel="noopener noreferrer" style="margin-top:8px">Reserve Free Ticket</a>
    </div>

    <script>
      const toggle = document.getElementById('nav-toggle');
      const mobile = document.getElementById('nav-mobile');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        mobile?.classList.toggle('is-open', !open);
        document.body.classList.toggle('nav-open', !open);
      });
      // Close on link click
      mobile?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
        toggle?.setAttribute('aria-expanded', 'false');
        mobile.classList.remove('is-open');
        document.body.classList.remove('nav-open');
      }));

      // Footer signup — swap email → name field
      (() => {
        const form = document.getElementById('footer-signup');
        if (!form) return;
        const hiddenEmail = form.querySelector('input[name="email"]');
        const field       = form.querySelector('#footer-field');
        const btn         = form.querySelector('button[type="submit"]');
        const msg         = form.querySelector('.footer-signup__msg');
        let step = 1;

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (step === 1) {
            const val = field.value.trim();
            if (!val || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
              msg.textContent = 'Please enter a valid email.';
              return;
            }
            hiddenEmail.value = val;
            msg.textContent = '';
            // Swap to name field
            field.style.opacity = '0';
            setTimeout(() => {
              field.type = 'text';
              field.placeholder = 'Your name';
              field.autocomplete = 'name';
              field.value = '';
              field.style.opacity = '1';
              btn.textContent = 'Sign Up';
              step = 2;
              field.focus();
            }, 150);
            return;
          }

          // Step 2 — submit
          btn.disabled = true;
          btn.textContent = 'Sending…';
          const name = field.value.trim();
          const [firstName, ...rest] = name.split(' ');
          try {
            const res = await fetch('/api/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                email: hiddenEmail.value,
                firstName: firstName || undefined,
                lastName: rest.join(' ') || undefined,
              }),
            });
            const data = await res.json();
            if (!res.ok || data.error) throw new Error(data.error ?? 'Something went wrong.');
            form.innerHTML = '<p style="font-size:14px;font-weight:600;color:var(--cream-200)">You\'re on the list!</p>';
          } catch (err) {
            msg.textContent = err.message ?? 'Could not subscribe — please try again.';
            btn.disabled = false;
            btn.textContent = 'Sign Up';
          }
        });
      })();
    </script>

    <slot />

    <footer class="footer">
      <div class="container">
        <div class="footer__top">
          <div class="footer__brand">
            <img src="/assets/brand/logo-reversed.png" alt="Singing on Grandfather" />
            <div class="footer__tag">A century of gospel music on Grandfather Mountain. Halfway to Heaven.</div>
          </div>
          <div class="footer__cols">
            <div class="footer__col">
              <h5>Festival</h5>
              <a href="/lineup">2026 Line Up</a>
              <a href="/archive">Past Line Ups</a>
              <a href="/participants">History of Participants</a>
              <a href="https://www.eventbrite.com/e/singing-on-grandfather-2026-tickets-1983169223533" target="_blank" rel="noopener noreferrer">Reserve Tickets</a>
            </div>
            <div class="footer__col">
              <h5>Plan Your Visit</h5>
              <a href="/#getting-there">Getting There</a>
              <a href="/camping">Camping &amp; Resources</a>
              <a href="/about">About the Festival</a>
            </div>
            <div class="footer__col">
              <h5>Connect</h5>
              <a href="https://www.facebook.com/SingingOnGrandfather" target="_blank" rel="noopener noreferrer">Facebook</a>
              <a href="https://www.instagram.com/singingongrandfather" target="_blank" rel="noopener noreferrer">Instagram</a>
              <a href="/supporters">Support the Festival</a>
              <div style="margin-top:16px">
                <div style="font-size:12px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--cream-300);margin-bottom:8px">Stay Connected</div>
                <form id="footer-signup" class="footer-signup" novalidate>
                  <input type="hidden" name="email" />
                  <div class="footer-signup__row">
                    <input class="footer-signup__input" id="footer-field" type="email" placeholder="Your email address" autocomplete="email" />
                    <button class="footer-signup__btn btn btn--accent" type="submit">Next →</button>
                  </div>
                  <p class="footer-signup__msg" aria-live="polite"></p>
                </form>
              </div>
            </div>
          </div>
        </div>
        <div class="footer__bottom">
          <span>MacRae Meadows · 2050 Blowing Rock Hwy, Linville, NC 28646</span>
          <span>© {new Date().getFullYear()} Singing on Grandfather</span>
        </div>
        <div class="footer__tagline">Where Voices Rise Above the Clouds</div>
      </div>
    </footer>
  </body>
</html>

<style>
  .footer__tagline {
    text-align: center;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.3);
    padding: 20px 0 24px;
    border-top: 1px solid rgba(255,255,255,0.08);
    margin-top: 8px;
  }

  .footer-signup__row {
    display: flex;
    gap: 8px;
  }
  .footer-signup__input {
    flex: 1;
    min-width: 0;
    padding: 9px 12px;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255,255,255,0.25);
    background: rgba(255,255,255,0.08);
    color: #fff;
    font-family: var(--font-body);
    font-size: 13px;
    outline: none;
    transition: opacity 0.15s, border-color 0.15s;
  }
  .footer-signup__input::placeholder { color: rgba(255,255,255,0.45); }
  .footer-signup__input:focus { border-color: rgba(255,255,255,0.5); }
  .footer-signup__msg {
    margin-top: 6px;
    font-size: 12px;
    color: #fca5a5;
    min-height: 16px;
  }

  /* Make nav links behave as links, not buttons */
  .nav__link {
    text-decoration: none;
    display: inline-block;
  }
  .nav__link:hover { text-decoration: none; }
  .nav__brand { text-decoration: none; }
</style>
