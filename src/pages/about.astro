---
import PageLayout from '../layouts/PageLayout.astro';
---
<PageLayout title="About the Festival">
  <main>
    <!-- Intro — title + story + image as one unified section -->
    <section class="section section--cream">
      <div class="container">
        <div class="eyebrow">Halfway to Heaven · Est. 1924</div>
        <hr class="tickrule" />
        <div class="about-intro">
          <div class="about-intro__text">
            <h1 class="pageheader__title" style="margin-bottom:32px">A century on<br />the mountain.</h1>
            <p class="lead">It began in 1924, when Joseph Larkin Hartley organized a simple church picnic on Grandfather Mountain — gospel music, fellowship, and worship in the open air on the fourth Sunday in June.</p>
            <p style="color:var(--ink-500);line-height:1.7">Stewarded for generations by the Hartley, MacRae, and Morton families, the free gathering grew into the longest-running gospel convention in the southern Appalachians. Today the Singing on Grandfather Foundation carries it forward — still free, still family, still rooted in the hope of the gospel.</p>
          </div>
          <div class="about-intro__img" style="background-image:url(/assets/photography/crowd-mountain.jpg);background-position:center 40%"></div>
        </div>
      </div>
    </section>

    <!-- Historical timeline banner video -->
    <div class="timeline-banner">
      <video autoplay muted loop playsinline>
        <source src="/assets/video/historical-timeline.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- Heritage -->
    <section class="section section--pine">
      <div class="container">
        <div class="heritage__head">
          <div>
            <div class="eyebrow">A Century of Voices</div>
            <h2 style="margin-top:12px">Who's stood on this mountain</h2>
          </div>
          <p style="color:var(--fg-on-dark-muted);max-width:320px;font-size:15px">From circuit-riding preachers to household names — a hundred years of voices have carried across MacRae Meadows.</p>
        </div>

        <div class="archival-grid">
          <div class="archival">
            <div class="archival__img" style="background-image:url(/assets/photography/heritage-boots-randolph.jpg)"></div>
            <div class="archival__cap">
              <div class="archival__name">Boots Randolph</div>
              <div class="archival__year">1970s</div>
            </div>
          </div>
          <div class="archival">
            <div class="archival__img" style="background-image:url(/assets/photography/heritage-johnny-cash-2.jpg)"></div>
            <div class="archival__cap">
              <div class="archival__name">Johnny Cash</div>
              <div class="archival__year">1974</div>
            </div>
          </div>
          <div class="archival">
            <div class="archival__img" style="background-image:url(/assets/photography/heritage-bob-hope-2.jpg)"></div>
            <div class="archival__cap">
              <div class="archival__name">Bob Hope</div>
              <div class="archival__year">1974</div>
            </div>
          </div>
          <a class="archival archival--link" href="/participants">
            <div class="archival--link__inner">
              <div style="font-family:var(--font-accent);font-style:italic;font-size:22px;color:var(--cream-100);line-height:1.3;margin-bottom:14px">…and a century more.</div>
              <div style="font-size:13px;color:var(--fg-on-dark-muted);line-height:1.7;margin-bottom:20px">Dr. Billy Graham · Roy Acuff · Oral Roberts · Roy Clark · Zig Ziglar · Dr. Gary Chapman</div>
              <span class="archival--link__cta">See all 100 years →</span>
            </div>
          </a>
        </div>

        <div class="timeline">
          <div class="tl-item"><div class="tl-year">1924</div><div class="tl-who">Joseph L. Hartley's first church picnic</div></div>
          <div class="tl-item"><div class="tl-year">1962</div><div class="tl-who">Dr. Billy Graham</div></div>
          <div class="tl-item"><div class="tl-year">1974</div><div class="tl-who">Bob Hope &amp; Johnny Cash</div></div>
          <div class="tl-item"><div class="tl-year">2024</div><div class="tl-who">Dr. Gary Chapman · the centennial</div></div>
          <div class="tl-item"><div class="tl-year">2026</div><div class="tl-who">The song continues</div></div>
        </div>

        <div class="heritage-videos">
          <div class="video-resp">
            <iframe
              src="https://www.youtube-nocookie.com/embed/DcpIufTWYkA"
              title="Singing on Grandfather — historical footage"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="video-resp">
            <iframe
              src="https://www.youtube-nocookie.com/embed/-djXw-eGeSQ"
              title="Singing on Grandfather — historical footage"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        </div>

        <div style="margin-top:40px">
          <a class="btn btn--outline-light" href="/participants">See all 100 years of participants →</a>
        </div>
      </div>
    </section>

    <!-- Mission -->
    <section class="section section--sky section--center">
      <div class="container">
        <div class="quoteband">
          <div class="quoteband__q">To share the hope of Jesus Christ through music, community, and encouragement.</div>
          <div class="quoteband__cite">Our Mission</div>
        </div>
      </div>
    </section>

    <!-- Foundation -->
    <section class="section section--cream">
      <div class="container">
        <div class="foundation-grid">
          <div class="foundation__text">
            <div class="eyebrow">About the Foundation</div>
            <h2 style="margin-top:14px;margin-bottom:24px">A tax-exempt,<br />public charity.</h2>
            <p style="color:var(--ink-600);line-height:1.75;margin-bottom:16px">Honoring the legacies of the Hartley &amp; Morton families and protecting the interests of The Grandfather Mountain Stewardship Foundation is the primary concern. With their direction and guidance, Owen Gwyn, Harris Prevost — who has helped with the event for forty years — and Rev. Michael McKee, along with like-minded local volunteers, are working to ensure Singing on Grandfather continues.</p>
            <p style="color:var(--ink-600);line-height:1.75;margin-bottom:16px">Building on the harmony of the original concept, the Singing on Grandfather Foundation welcomes local church participation. Gospel music is a common thread woven among all Christian traditions, and the divine power within it binds together the many-membered body of Christ's living church.</p>
            <p style="color:var(--ink-600);line-height:1.75">Singing on Grandfather is a multi-church body venue — a praise and worship platform designed to unify all believers in song. The Foundation provides the structural, technical, and operational expertise to ensure the successful and sustainable continuation of this gathering.</p>
            <div style="margin-top:28px;display:flex;align-items:center;gap:16px;flex-wrap:wrap">
              <a class="btn btn--accent" href="/supporters">Support the Ministry</a>
              <span class="tag">501(c)(3) · DLN 26053404003924</span>
            </div>
          </div>
          <div class="foundation__img" style="background-image:url(/assets/photography/billy-graham-rock.jpg);background-position:right center"></div>
        </div>
      </div>
    </section>

    <!-- Visit details -->
    <section class="section section--pine">
      <div class="container">
        <div class="visit-grid">
          <div>
            <div class="eyebrow">Plan Your Visit</div>
            <h2 style="margin-top:14px;margin-bottom:32px">Getting there</h2>
            <div class="visit-detail">
              <div class="visit-detail__label">When</div>
              <div class="visit-detail__value" style="color:var(--cream-100)">Sunday, June 28 · 11am – 4pm</div>
              <div class="visit-detail__sub" style="color:var(--fg-on-dark-muted)">Free admission · rain or shine</div>
            </div>
            <div class="visit-detail">
              <div class="visit-detail__label">Where</div>
              <div class="visit-detail__value" style="color:var(--cream-100)">MacRae Meadows, Grandfather Mountain</div>
              <div class="visit-detail__sub" style="color:var(--fg-on-dark-muted)">2050 Blowing Rock Hwy, Linville, NC 28646</div>
            </div>
            <div class="visit-detail">
              <div class="visit-detail__label">Know Before You Go</div>
              <div class="tags">
                <span class="tag" style="color:var(--cream-200);border-color:var(--line-on-dark)">Bring a chair</span>
                <span class="tag" style="color:var(--cream-200);border-color:var(--line-on-dark)">Pack a picnic</span>
                <span class="tag" style="color:var(--cream-200);border-color:var(--line-on-dark)">No alcohol</span>
                <span class="tag" style="color:var(--cream-200);border-color:var(--line-on-dark)">No pets</span>
                <span class="tag" style="color:var(--cream-200);border-color:var(--line-on-dark)">No on-site camping</span>
              </div>
            </div>
            <div style="margin-top:28px;display:flex;gap:14px;flex-wrap:wrap">
              <a class="btn btn--on-dark" href="https://maps.google.com/?q=MacRae+Meadows,2050+Blowing+Rock+Hwy,Linville,NC+28646" target="_blank" rel="noopener noreferrer">Get Directions</a>
              <a class="btn btn--outline-light" href="/lineup">See the 2026 Line Up</a>
            </div>
          </div>
          <div class="map-card" style="border-color:var(--line-on-dark)">
            <iframe
              src="https://maps.google.com/maps?q=MacRae+Meadows,+2050+Blowing+Rock+Hwy,+Linville,+NC+28646&output=embed&z=13"
              title="MacRae Meadows, Grandfather Mountain"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>
      </div>
    </section>
  </main>
</PageLayout>

<style>
  .about-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
    margin-top: 8px;
  }
  .about-intro__img {
    border-radius: 12px;
    aspect-ratio: 4/5;
    background-size: cover;
    background-position: center;
    position: sticky;
    top: 80px;
  }
  @media (max-width: 880px) {
    .about-intro { grid-template-columns: 1fr; }
    .about-intro__img { aspect-ratio: 16/9; position: static; }
  }

  .foundation-grid {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 64px;
    align-items: start;
  }
  .foundation__img {
    border-radius: var(--radius-lg);
    aspect-ratio: 4/3;
    background-size: cover;
    background-position: center 40%;
    position: sticky;
    top: 80px;
    box-shadow: var(--shadow-lg);
  }
  @media (max-width: 900px) {
    .foundation-grid { grid-template-columns: 1fr; }
    .foundation__img { position: static; aspect-ratio: 16/9; }
  }

  .map-card iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .archival-grid {
    grid-template-columns: repeat(4, 1fr);
  }
  .archival--link {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    text-decoration: none;
    transition: opacity 0.18s;
  }
  .archival--link:hover { opacity: 0.85; }
  .archival--link__inner {
    padding: 28px 26px;
  }
  .archival--link__cta {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brass-300);
    border-bottom: 1px solid var(--brass-300);
    padding-bottom: 2px;
  }
  @media (max-width: 900px) {
    .archival-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .archival-grid { grid-template-columns: 1fr; }
  }

  .heritage-videos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 40px;
  }
  @media (max-width: 720px) {
    .heritage-videos { grid-template-columns: 1fr; }
  }
  .video-resp {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--pine-900);
    box-shadow: var(--shadow-lg);
  }
  .video-resp iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .timeline-banner {
    width: 100%;
    overflow: hidden;
    line-height: 0;
    background: var(--pine-900);
  }
  .timeline-banner video {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
