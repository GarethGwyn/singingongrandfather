const STOPWORDS = ['dr','rev','gov','rep','prof','judge','gen','coach','mr','mrs','ms','sr','jr','the','of'];
function initials(name: string): string {
  const s = name.replace(/<\/?muted>/g, '').split(/[·—;,]/)[0].trim();
  const words = s.split(/\s+/).filter(w => {
    const c = w.replace(/[^a-zA-Z]/g, '').toLowerCase();
    return c && !STOPWORDS.includes(c);
  });
  return ((words[0] || ' ')[0] + (words[1] || '')[0] || '').toUpperCase().slice(0, 2) || '•';
}
const TINTS = ['#283A2E', '#2E6FB0', '#9A7B3F', '#3D5242', '#173A5E'];
function tintFor(name: string): string {
  let h = 0;
  for (let i = 0; i < name.length; i++) h = (h * 31 + name.charCodeAt(i)) | 0;
  return TINTS[Math.abs(h) % TINTS.length];
}

// Group by decade
type DecadeGroup = { dec: number; rows: [number, string, ParticipantMeta][] };
const decades: DecadeGroup[] = [];
let cur: DecadeGroup | null = null;
for (const [y, n, meta] of PARTICIPANTS) {
  const dec = Math.floor(y / 10) * 10;
  if (!cur || cur.dec !== dec) { cur = { dec, rows: [] }; decades.push(cur); }
  cur.rows.push([y, n, meta || {}]);
}
---
<PageLayout title="A Century of Participants">
  <main>
    <div class="pageheader section--cream">
      <div class="container">
        <a class="nav__link" style="margin-bottom:18px;color:var(--sky-700);display:inline-block" href="/about">← Back to About</a>
        <div class="eyebrow">Since 1924</div>
        <hr class="tickrule" />
        <h1 class="pageheader__title">A century of<br />participants.</h1>
        <p class="lead" style="margin-top:18px">Every speaker and singer who has stood on the mountain, year by year — from circuit-riding preachers to household names.</p>
      </div>
    </div>

    <section class="section section--cream section--tight">
      <div class="container">
        <div class="roster">
          {decades.map(({ dec, rows }) => (
            <div class="roster__decade">
              <div class="roster__decade-label">{dec}s</div>
              {rows.map(([year, name, meta]) => {
                const isMuted = /^<muted>/.test(name);
                const cleanName = name.replace(/<\/?muted>/g, '');
                const imgUrl = meta.img || photoUrl(year);
                return (
                  <div class={`roster-row${meta.notable ? ' is-notable' : ''}`}>
                    {imgUrl
                      ? <div class="roster-row__avatar" data-archival="true" style={`background-image:url(${imgUrl})`}></div>
                      : isMuted
                        ? <div class="roster-row__avatar is-empty">–</div>
                        : <div class="roster-row__avatar" style={`background:${tintFor(name)}`}>{initials(name)}</div>
                    }
                    <div class="roster-row__year tnum">{year}</div>
                    <div class="roster-row__name">
                      {isMuted ? <span class="muted">{cleanName}</span> : cleanName}
                    </div>
                    {meta.tag && <div class="roster-row__tag">{meta.tag}</div>}
                  </div>
                );
              })}
            </div>
          ))}
        </div>
        <p class="caption" style="margin-top:40px">Gaps reflect years without a recorded speaker. Compiled from the festival's own history.</p>
      </div>
    </section>
  </main>
</PageLayout>
