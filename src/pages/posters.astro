---
import PageLayout from '../layouts/PageLayout.astro';
---
<PageLayout title="Event Posters">
  <main>
    <div class="pageheader section--cream">
      <div class="container">
        <a class="nav__link" style="margin-bottom:18px;color:var(--sky-700);display:inline-block" href="/archive">← Back to Archive</a>
        <div class="eyebrow">Festival Posters</div>
        <hr class="tickrule" />
        <h1 class="pageheader__title">Event Posters</h1>
        <p class="lead" style="margin-top:18px">Official poster art for Singing on Grandfather. Designed by Shake.</p>
      </div>
    </div>

    <section class="section section--cream section--tight" style="padding-top:24px">
      <div class="container">
        <p class="poster-caption-top">Click a poster to open full resolution.</p>
        <div class="poster-row">
          <div class="poster-col">
            <div class="poster-year-label">2026</div>
            <div class="poster-card">
              <a href="/assets/brand/poster-2026-v1.png" target="_blank" rel="noopener noreferrer">
                <img src="/assets/brand/poster-2026-v1.png" alt="Singing on Grandfather 2026 Poster" />
              </a>
            </div>
          </div>
          <div class="poster-col">
            <div class="poster-year-label">2025</div>
            <div class="poster-card">
              <a href="/assets/brand/poster-2025.png" target="_blank" rel="noopener noreferrer">
                <img src="/assets/brand/poster-2025.png" alt="Singing on Grandfather 2025 Poster" />
              </a>
            </div>
          </div>
          <div class="poster-col">
            <div class="poster-year-label">2024</div>
            <div class="poster-card">
              <a href="/assets/brand/poster-2024.png" target="_blank" rel="noopener noreferrer">
                <img src="/assets/brand/poster-2024.png" alt="Singing on Grandfather 2024 Poster" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</PageLayout>

<style>
  .poster-caption-top {
    font-size: 12px;
    color: var(--ink-400);
    text-align: center;
    margin-bottom: 32px;
    letter-spacing: 0.03em;
  }
  .poster-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    max-width: 1000px;
    margin: 0 auto;
  }
  .poster-col {
    display: flex;
    flex-direction: column;
  }
  .poster-year-label {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-400);
    margin-bottom: 14px;
    text-align: center;
  }
  .poster-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .poster-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 48px rgba(15,25,18,0.18);
  }
  .poster-card a { display: block; line-height: 0; }
  .poster-card img { width: 100%; height: auto; display: block; }
  @media (max-width: 700px) {
    .poster-row { grid-template-columns: 1fr; gap: 36px; }
  }
</style>
