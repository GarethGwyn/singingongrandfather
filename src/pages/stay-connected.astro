---
import PageLayout from '../layouts/PageLayout.astro';
import EmailSignup from '../components/EmailSignup.astro';
---
<PageLayout title="Stay Connected">
  <main>
    <div class="pageheader section--cream">
      <div class="container">
        <div class="eyebrow">Stay Connected</div>
        <hr class="tickrule" />
        <h1 class="pageheader__title">Don't miss<br />a note.</h1>
        <p class="lead" style="margin-top:18px">Line-up announcements, schedule updates, and a little encouragement from the mountain — straight to your inbox.</p>
      </div>
    </div>

    <section class="section section--sky">
      <div class="container" style="max-width:560px;margin:0 auto">
        <EmailSignup id="stay-connected-signup" btnLabel="Subscribe" />
        <p style="font-size:13px;color:var(--ink-400);margin-top:16px;text-align:center">No spam — ever. Unsubscribe any time.</p>
      </div>
    </section>

    <section class="section section--cream">
      <div class="container" style="text-align:center">
        <div class="eyebrow" style="margin-bottom:16px">Also Follow Along</div>
        <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap">
          <a class="btn btn--secondary" href="https://www.facebook.com/SingingOnGrandfather" target="_blank" rel="noopener noreferrer">Facebook</a>
          <a class="btn btn--secondary" href="https://www.instagram.com/singingongrandfather" target="_blank" rel="noopener noreferrer">Instagram</a>
          <a class="btn btn--accent" href="https://www.eventbrite.com/e/singing-on-grandfather-2026-tickets-1983169223533" target="_blank" rel="noopener noreferrer">Reserve Your Free Ticket</a>
        </div>
      </div>
    </section>
  </main>
</PageLayout>
