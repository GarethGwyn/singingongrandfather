---
import PageLayout from '../layouts/PageLayout.astro';
---
<PageLayout title="Stay Connected">
  <main>
    <div class="pageheader section--cream">
      <div class="container">
        <div class="eyebrow">Stay Connected</div>
        <hr class="tickrule" />
        <h1 class="pageheader__title">Don't miss<br />a note.</h1>
        <p class="lead" style="margin-top:18px">Line-up announcements, schedule updates, and a little encouragement from the mountain — straight to your inbox.</p>
      </div>
    </div>

    <section class="section section--sky section--center">
      <div class="container">
        <div class="donate" style="text-align:left">
          <!-- Success state (hidden by default) -->
          <div id="form-success" style="display:none;text-align:center;padding:20px 0">
            <div style="font-family:var(--font-display);font-weight:800;font-size:26px;color:var(--pine-900)">You're on the list.</div>
            <p style="color:var(--ink-500);margin-top:8px;margin-bottom:0">See you on the mountain.</p>
          </div>
          <!-- Sign-up form — TODO: wire action to Constant Contact embed / API -->
          <form id="signup-form">
            <div class="eyebrow" style="margin-bottom:6px">Join the Family</div>
            <h3 style="margin-top:0;margin-bottom:20px">Sign up for festival news</h3>
            <div class="field-row">
              <div class="field">
                <label for="first-name">First Name</label>
                <input id="first-name" class="inp" name="first_name" placeholder="First" autocomplete="given-name" />
              </div>
              <div class="field">
                <label for="last-name">Last Name</label>
                <input id="last-name" class="inp" name="last_name" placeholder="Last" autocomplete="family-name" />
              </div>
            </div>
            <div class="field" style="margin-top:14px">
              <label for="email">Email</label>
              <input id="email" class="inp" name="email" type="email" required placeholder="you@email.com" autocomplete="email" />
            </div>
            <button type="submit" class="btn btn--accent btn--lg" style="width:100%;margin-top:22px">Subscribe</button>
            <p class="caption" style="margin-top:14px;margin-bottom:0;text-align:center">We'll only email about the festival. Unsubscribe anytime.</p>
          </form>
        </div>
      </div>
    </section>
  </main>
</PageLayout>

<script>
  const form = document.getElementById('signup-form') as HTMLFormElement;
  const success = document.getElementById('form-success') as HTMLElement;

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    // TODO: POST to Constant Contact API or redirect to their embed form
    form.style.display = 'none';
    success.style.display = 'block';
  });
</script>
