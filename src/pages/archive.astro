---
import PageLayout from '../layouts/PageLayout.astro';

const ARCHIVE = {
  2026: {
    date: "June 28, 2026",
    time: "11am – 4pm · MacRae Meadows",
    blurb: "A day of song on the mountain, headlined by four-time IBMA Female Vocalist Brooke Aldridge and evangelist Doug Elks.",
    acts: [
      { name: "Darin & Brooke Aldridge", role: "Headliner", feature: true, img: "/assets/performers/aldridge.png" },
      { name: "Doug Elks", role: "Keynote Speaker", feature: true, img: "/assets/performers/doug-elks.png" },
      { name: "Rev. Michael McKee", role: "Opening Prayer", img: "/assets/performers/rev-mckee.jpg" },
      { name: "Patricia Smith", role: "Gospel", img: "/assets/performers/patricia-smith.jpg" },
      { name: "Boone & Church", role: "Bluegrass", img: "/assets/performers/boone-church.jpg" },
      { name: "Caldwell Men's Chorus", role: "Chorus", img: "/assets/performers/caldwell-mens-chorus.jpg" },
    ],
    trucks: [
      { name: "The Tasty Traveler", icon: "🚚" },
      { name: "Appalachian High Country Concessions", icon: "🏔️" },
      { name: "Mookie's Kettle Korn", icon: "🍿" },
      { name: "Buttercups Ice Cream & Beverages", icon: "🍦" },
      { name: "Sips Soda Shop", icon: "🥤" },
      { name: "Cubs Snak Shak", icon: "🥨" },
      { name: "Blue Ridge Cantina", icon: "🌮" },
    ],
    photos: [
      "/assets/photography/2026/sog-2026-01.jpg",
      "/assets/photography/2026/sog-2026-02.jpg",
      "/assets/photography/2026/sog-2026-03.jpg",
      "/assets/photography/2026/sog-2026-04.jpg",
      "/assets/photography/2026/sog-2026-05.jpg",
      "/assets/photography/2026/sog-2026-06.jpg",
      "/assets/photography/2026/sog-2026-07.jpg",
      "/assets/photography/2026/sog-2026-08.jpg",
      "/assets/photography/2026/sog-2026-09.jpg",
      "/assets/photography/2026/sog-2026-10.jpg",
      "/assets/photography/2026/sog-2026-11.jpg",
      "/assets/photography/2026/sog-2026-12.jpg",
    ],
  },
  2025: {
    date: "June 22, 2025",
    time: "11am – 4pm · MacRae Meadows",
    blurb: "A Christ-centered, non-denominational church picnic featuring The Cockman Family and Rev. Johnson Bowie.",
    acts: [
      { name: "The Cockman Family", role: "Headliner", feature: true, img: "/assets/performers/cockman-family.png" },
      { name: "Rev. Johnson Bowie", role: "Speaker", feature: true, img: "/assets/performers/johnson-bowie.jpg" },
      { name: "Patricia Smith", role: "Gospel", img: "/assets/performers/patricia-smith.jpg" },
      { name: "The Collective", role: "Gospel Band", img: "/assets/performers/the-collective.png" },
      { name: "Guilford", role: "Americana", img: "/assets/performers/guilford.jpg" },
      { name: "Caldwell Men's Chorus", role: "Chorus", img: "/assets/performers/caldwell-mens-chorus.jpg" },
      { name: "Arbor Dale Presbyterian", role: "Worship Choir", img: "/assets/performers/arbor-dale-presbyterian.jpg" },
      { name: "Rev. Michael McKee", role: "Worship", img: "/assets/performers/rev-mckee.jpg" },
    ],
  },
  2024: {
    date: "June 16, 2024",
    time: "9am – 3pm · MacRae Meadows",
    blurb: "A picnic of local gospel music, with keynote Dr. Gary Chapman, author of The Five Love Languages.",
    acts: [
      { name: "Dr. Gary Chapman", role: "Keynote Speaker", feature: true, img: "/assets/performers/gary-chapman.jpg" },
      { name: "The King James Boys", role: "Bluegrass Gospel", feature: true, img: "/assets/performers/king-james-boys.png" },
      { name: "Michael Combs", role: "Gospel", img: "/assets/performers/michael-combs.jpg" },
      { name: "Patricia Smith", role: "Gospel", img: "/assets/performers/patricia-smith-2024.png" },
      { name: "Charles Pettee & FolkPsalm", role: "Folk Psalms", img: "/assets/performers/folkpsalm.jpg" },
      { name: "Erica Renee McKinney", role: "Singer-Songwriter", img: "/assets/performers/erica-mckinney.png" },
      { name: "Servant's Heart", role: "Gospel Trio", img: "/assets/performers/servants-heart.jpg" },
      { name: "New Covenant", role: "Southern Gospel", img: "/assets/performers/new-covenant.png" },
      { name: "The Collective", role: "Gospel Band", img: "/assets/performers/the-collective.png" },
    ],
  },
};
---
<PageLayout title="The Archive">
  <main>
    <div class="pageheader section--cream">
      <div class="container">
        <a class="nav__link" style="margin-bottom:18px;color:var(--sky-700);display:inline-block" href="/">← Back to Home</a>
        <div class="eyebrow">Past Line Ups</div>
        <hr class="tickrule" />
        <h1 class="pageheader__title">The archive.</h1>
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;margin-top:8px">
          <div class="yeartoggle">
            <button class="yeartoggle__btn is-on" data-year="2026">2026</button>
            <button class="yeartoggle__btn" data-year="2025">2025</button>
            <button class="yeartoggle__btn" data-year="2024">2024</button>
          </div>
          <a class="btn btn--secondary" href="/posters">Event Posters →</a>
        </div>
      </div>
    </div>

    {[2026, 2025, 2024].map(year => {
      const data = ARCHIVE[year as 2026 | 2025 | 2024];
      const features = data.acts.filter(a => a.feature);
      const rest = data.acts.filter(a => !a.feature);
      const trucks = 'trucks' in data ? data.trucks : null;
      const photos = 'photos' in data ? data.photos : null;
      return (
        <div data-archive={year} class={year === 2026 ? '' : 'archive-hidden'}>
          <section class="section section--cream section--tight">
            <div class="container">
              <div class="section__head">
                <div class="eyebrow">{data.date}</div>
                <h2 style="margin-top:10px">{data.time}</h2>
                <p class="lead" style="margin-top:12px">{data.blurb}</p>
              </div>
              <div class="grid-performers">
                {features.map(a => (
                  <div class="perf">
                    <div class="perf__img" style={`background-image:url(${a.img})`}></div>
                    <div class="perf__body">
                      <div class="perf__role">{a.role}</div>
                      <h3 class="perf__name">{a.name}</h3>
                    </div>
                  </div>
                ))}
              </div>
              <div class="video-wrap" style="margin-top:48px">
                <div class="eyebrow" style="margin-bottom:16px">{year} Overview Reel</div>
                <div class="video-resp">
                  <iframe
                    src={`https://www.youtube-nocookie.com/embed/${year === 2026 ? 'l6CBImnIf8M' : year === 2025 ? 'akOwD2tajYM' : 'TZoximbEUjU'}`}
                    title={`Singing on Grandfather ${year} Overview`}
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                  ></iframe>
                </div>
              </div>
            </div>
          </section>
          {rest.length > 0 && (
          <section class="section section--sunk">
            <div class="container">
              <div class="section__head">
                <div class="eyebrow">Also That Year</div>
                <h2>The full day</h2>
              </div>
              <div class="grid-4">
                {rest.map(a => (
                  <div class="perf perf--sm">
                    <div class="perf__img" style={`background-image:url(${a.img})`}></div>
                    <div class="perf__body">
                      <div class="perf__role">{a.role}</div>
                      <h3 class="perf__name">{a.name}</h3>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </section>
          )}
          {photos && (
          <section class="section section--pine">
            <div class="container">
              <div class="section__head" style="text-align:center;margin-left:auto;margin-right:auto">
                <div class="eyebrow">Scenes from the Day</div>
                <h2 style="color:#fff;margin-top:12px">On the mountain, {year}</h2>
              </div>
              <div class="archive-gallery">
                {photos.map((src, i) => (
                  <a class="archive-gallery__tile" href={src} target="_blank" rel="noopener noreferrer" style={`background-image:url(${src})`} aria-label={`Photo ${i + 1}`}></a>
                ))}
              </div>
            </div>
          </section>
          )}
          {trucks && (
          <section class="section section--cream">
            <div class="container">
              <div class="section__head" style="text-align:center;margin-left:auto;margin-right:auto">
                <div class="eyebrow">On the Grounds</div>
                <h2 style="margin-top:12px">Food Trucks</h2>
              </div>
              <div class="archive-trucks">
                {trucks.map(t => (
                  <div class="truck-chip">
                    <span class="truck-chip__icon">{t.icon}</span>
                    {t.name}
                  </div>
                ))}
              </div>
            </div>
          </section>
          )}
        </div>
      );
    })}
  </main>
</PageLayout>

<style>
  .archive-hidden { display: none; }
  .archive-trucks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 700px;
    margin: 32px auto 0;
  }
  .truck-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #fff;
    border: 1px solid var(--line);
    color: var(--pine-800);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 14px;
    padding: 8px 18px 8px 14px;
    border-radius: 999px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .truck-chip__icon { font-size: 17px; line-height: 1; }

  .archive-gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 40px;
  }
  .archive-gallery__tile {
    display: block;
    aspect-ratio: 4 / 3;
    background-size: cover;
    background-position: center;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .archive-gallery__tile:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.35);
  }
  @media (max-width: 900px) {
    .archive-gallery { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 600px) {
    .archive-gallery { grid-template-columns: repeat(2, 1fr); gap: 8px; }
  }
  .video-resp {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--pine-900);
    box-shadow: var(--shadow-lg);
  }
  .video-resp iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  const yearBtns = document.querySelectorAll<HTMLButtonElement>('.yeartoggle__btn');
  const archiveSections = document.querySelectorAll<HTMLElement>('[data-archive]');

  yearBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const year = btn.dataset.year!;
      yearBtns.forEach(b => b.classList.toggle('is-on', b.dataset.year === year));
      archiveSections.forEach(s => s.classList.toggle('archive-hidden', s.dataset.archive !== year));
    });
  });
</script>
