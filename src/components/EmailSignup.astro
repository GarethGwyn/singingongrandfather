---
interface Props {
  id: string;
  dark?: boolean;
  compact?: boolean;      // side-by-side input+button
  showName?: boolean;     // show name fields above email (stacked)
  progressive?: boolean;  // email first, name reveals after (footer)
  placeholder?: string;
  btnLabel?: string;
}

const {
  id,
  dark = false,
  compact = false,
  showName = false,
  progressive = false,
  placeholder = 'Your email address',
  btnLabel = 'Stay Connected',
} = Astro.props;
---

<form class={`email-signup${compact ? ' email-signup--compact' : ''}${dark ? ' email-signup--dark' : ''}`}
      id={id}
      novalidate>
  {showName && (
    <div class="email-signup__name-row">
      <input class="email-signup__input" type="text" name="firstName" placeholder="First name" autocomplete="given-name" />
      <input class="email-signup__input" type="text" name="lastName"  placeholder="Last name"  autocomplete="family-name" />
    </div>
  )}
  {progressive && (
    <div class="email-signup__name-row email-signup__name-reveal" style="display:none">
      <input class="email-signup__input" type="text" name="firstName" placeholder="First name" autocomplete="given-name" />
      <input class="email-signup__input" type="text" name="lastName"  placeholder="Last name"  autocomplete="family-name" />
    </div>
  )}
  <div class="email-signup__row">
    <input
      class="email-signup__input"
      type="email"
      name="email"
      autocomplete="email"
      placeholder={placeholder}
      required
    />
    <button class="email-signup__btn btn btn--accent" type="submit">{progressive ? 'Next →' : btnLabel}</button>
  </div>
  <p class="email-signup__msg" aria-live="polite"></p>
</form>

<script define:vars={{ id, progressive, btnLabel }}>
  const form = document.getElementById(id);
  if (!form) return;

  const emailInput = form.querySelector('input[name="email"]');
  const firstInput = form.querySelector('input[name="firstName"]');
  const lastInput  = form.querySelector('input[name="lastName"]');
  const nameReveal = form.querySelector('.email-signup__name-reveal');
  const msg  = form.querySelector('.email-signup__msg');
  const btn  = form.querySelector('button[type="submit"]');

  let step = progressive ? 1 : 2; // 1 = email only, 2 = ready to submit

  async function submitForm() {
    const email = emailInput?.value?.trim();
    if (!email) return;

    btn.disabled = true;
    btn.textContent = 'Sending…';
    if (msg) { msg.textContent = ''; msg.className = 'email-signup__msg'; }

    try {
      const payload = {
        email,
        firstName: firstInput?.value?.trim() || undefined,
        lastName:  lastInput?.value?.trim()  || undefined,
      };
      const res  = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok || data.error) throw new Error(data.error ?? 'Something went wrong.');
      form.innerHTML = '<p class="email-signup__success">You\'re on the list! We\'ll be in touch before June 28.</p>';
    } catch (err) {
      if (msg) {
        msg.textContent = err.message ?? 'Could not subscribe — please try again.';
        msg.className = 'email-signup__msg is-error';
      }
      btn.disabled = false;
      btn.textContent = step === 1 ? 'Next →' : btnLabel;
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (progressive && step === 1) {
      const email = emailInput?.value?.trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        if (msg) { msg.textContent = 'Please enter a valid email.'; msg.className = 'email-signup__msg is-error'; }
        return;
      }
      // Reveal name fields
      if (nameReveal) nameReveal.style.display = 'flex';
      if (msg) { msg.textContent = ''; msg.className = 'email-signup__msg'; }
      btn.textContent = btnLabel;
      emailInput.readOnly = true;
      step = 2;
      firstInput?.focus();
      return;
    }

    await submitForm();
  });
</script>

<style>
  .email-signup__name-row {
    display: flex;
    gap: 10px;
    margin-bottom: 10px;
  }
  .email-signup__name-row .email-signup__input { flex: 1; }
  .email-signup__row {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .email-signup--compact .email-signup__row {
    flex-direction: row;
  }
  .email-signup__input {
    flex: 1;
    padding: 11px 14px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--ink-900);
    background: #fff;
    outline: none;
    transition: border-color 0.15s;
    width: 100%;
  }
  .email-signup__input:focus { border-color: var(--accent); }
  .email-signup__input[readonly] { opacity: 0.6; cursor: default; }
  .email-signup--dark .email-signup__input {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.3);
    color: #fff;
  }
  .email-signup--dark .email-signup__input::placeholder { color: rgba(255,255,255,0.5); }
  .email-signup__btn { white-space: nowrap; }
  .email-signup__msg {
    margin-top: 8px;
    font-size: 13px;
    min-height: 18px;
  }
  .email-signup__msg.is-error { color: var(--coral-600); }
  .email-signup--dark .email-signup__msg.is-error { color: #fca5a5; }
  .email-signup__success {
    font-size: 15px;
    font-weight: 600;
    color: var(--pine-700);
    margin: 0;
  }
  .email-signup--dark .email-signup__success { color: var(--cream-100); }
  @media (max-width: 480px) {
    .email-signup__name-row { flex-direction: column; }
  }
</style>
